{
	"//": "Typechecks the root tool configs, so `tsc -b` has work before the first package exists.",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"emitDeclarationOnly": true,
		"sourceMap": false,
		"outDir": "node_modules/.cache/tsc/tools"
	},
	"include": ["vitest.config.mts", "vitest.context.d.ts"]
}
