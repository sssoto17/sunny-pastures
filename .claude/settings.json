	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secret-paste.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-branch-switch.sh",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-coordinator-work.sh",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "root=$(git rev-parse --show-toplevel 2>/dev/null) && cd \"$root\" && [ -d node_modules ] || exit 0; command -v pnpm >/dev/null || { echo \"check:fast skipped: pnpm not on PATH\" >&2; exit 1; }; pnpm --silent check:fast >&2 || exit 2",
						"timeout": 30
					}
				]
			}
		]
	},
	"env": {
		"GH_TELEMETRY": "false"
	},
	"remote": {
