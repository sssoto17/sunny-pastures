# dependencies
node_modules/

# builds and test output
.next/
# Next writes it on every build and says not to commit it. apps/web's tsconfig loads `next`'s
# types itself, so a checkout without a build still typechecks.
next-env.d.ts
out/
dist/
coverage/
*.tsbuildinfo
test-results/
playwright-report/

# env files: only examples are committed
.env*
!.env*.example

# Python (tools/load, tools/analysis)
.venv/
__pycache__/
.ipynb_checkpoints/

# Supabase local stack
supabase/.branches/
supabase/.temp/

# agent and editor scratch
.claude/settings.local.json
.claude/worktrees/
.claude/.cc-writes
.scratch/
.DS_Store
.vscode/
*.log

# GitHub App private keys: save them outside the repo; this stops one being committed by accident
*.pem

# Stryker (stryker.config.mjs): its sandbox and reports
.stryker-tmp/
/reports/mutation/
