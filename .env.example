# Copy to .env and fill in. .env is never committed.

# Local Supabase Postgres. `pnpm db:env` writes both after `pnpm db:reset` (supabase/README.md).
# The app connects as game_api, whose password db:env generates; it's never committed (#372).
DATABASE_URL=postgresql://game_api:<password>@127.0.0.1:55322/postgres
# The postgres role, for the db tests only (#382): it sets up test players and acts as anon. Never the app's.
ADMIN_DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:55322/postgres

# Local Supabase API and its publishable key (#371). `pnpm db:env` writes both from the running
# stack without printing them.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=<publishable key>

# The browser's Supabase client (ADR-0010, section 5): the same local API and publishable key as
# above, under the names Next.js exposes to the browser. The publishable key is public by design.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
# Optional: the base URL the real sprites are served from (ADR-0010, section 7). Left empty or unset,
# the game uses placeholder sprites committed to the repo.
NEXT_PUBLIC_ART_BASE_URL=
