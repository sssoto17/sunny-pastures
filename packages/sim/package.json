{
	"name": "@sunny-pastures/sim",
	"private": true,
	"description": "The game rules as pure TypeScript: zero runtime dependencies, no I/O (ADR-0003).",
	"type": "module",
	"exports": {
		".": {
			"@sunny-pastures/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./versions": {
			"@sunny-pastures/source": "./src/versions/index.ts",
			"types": "./dist/versions/index.d.ts",
			"default": "./dist/versions/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
	},
	"devDependencies": {
		"fast-check": "4.10.2"
	}
}
