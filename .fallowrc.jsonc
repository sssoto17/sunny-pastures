// Fallow (CONSTRAINTS.md, "Tools are dependencies"). Loosening anything here is a moved threshold
// that the floor guard reports.
{
  "$schema": "./node_modules/fallow/schema.json",
  // The changed-code gate (CONSTRAINTS.md, the Duplication, Complexity and Dead code rows; #503):
  // `pnpm audit:changed` in `check:task`, `check:full` and `ci / lint` runs `fallow audit` over the
  // whole repo against the merge base. `new-only` fails a PR only on what it introduces, so the
  // inherited backlog (#503: 31 clone groups, 35 functions over the thresholds) passes. A function
  // already over a threshold that grows gets Fallow's default `worsened` verdict: a warning.
  "audit": { "gate": "new-only" },
  // Fallow's own defaults, written out so the Complexity row's numbers live here. CRAP comes from
  // coverage/coverage-final.json when a test run left one (Fallow reads it on its own; `check:full`
  // names it), and from Fallow's static estimate of test reachability otherwise, as in `ci / lint`.
  "health": { "maxCyclomatic": 20, "maxCognitive": 15, "maxCrap": 30 },
  // Dead code (CONSTRAINTS.md, Dead code row). drizzle-kit reads every export of the store's
  // schema (apps/web/drizzle.config.json; `game` makes it write `CREATE SCHEMA`), and Fallow's
  // drizzle plugin doesn't read a drizzle.config.json, so the schema is an entry here.
  "entry": ["apps/web/src/server/store/schema.ts"],
  // The Supabase CLI is a system binary, pinned by `pnpm supabase:check`, not an npm package.
  "ignoreBinaries": ["supabase"],
  // ADR-0007, section 3 ("Errors"): the error body's types are exported for the M4 client, and
  // where the client reads them from is still M4's decision (ADR-0007, "Open, for the admin").
  "ignoreExports": [
    { "file": "apps/web/src/server/http/index.ts", "exports": ["ErrorCode", "ErrorBody"] }
  ],
  // Duplication (CONSTRAINTS.md, duplication row; ADR-0005, section 3): exact copies of 50 tokens
  // and 5 lines or more. `mild` matches token for token, so two loops of the same shape over
  // different data aren't clones ("the same rule, not the same shape"). Fallow's built-in
  // defaults leave out *.test.ts files, and the row covers the sim's tests too, so this config
  // doesn't use them.
  // `threshold` makes `fallow audit` fail on a clone the change introduces: without it a new
  // clone group is only a `warn` verdict, which neither the commit gate
  // (.claude/hooks/fallow-gate.sh) nor CI blocks (#504). The audit fails when the change
  // introduces a clone group and the repo's duplicated share is over the threshold, so a value
  // this small means any new clone; inherited clones keep a `pass`. A tightening: 0 is no limit.
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "ignoreDefaults": false,
    "threshold": 0.000001
  },
  // apps/web's layers (CONSTRAINTS.md, "Boundaries: server-only"; #329 decision 3, #342). Only a
  // route imports api/, only api/ wires the server modules together, and client code (pages)
  // reaches the sim's package entry and nothing in src/server/ (ADR-0006). Zones for modules that
  // don't exist yet are declared now, so each lands inside its rule. `allowTypeOnly` admits
  // `import type` only: game/ sees the store's interface, never its code, and auth's `PlayerId`,
  // never `readPlayer` (#332 decision 4); store/ sees the sim's types, never its values
  // (ADR-0001). The sim (CONSTRAINTS.md, "Boundaries: sim purity (MUST-10.1)") imports no other
  // zone, tests included, and calls nothing in `calls.forbidden`.
  // Fallow sees zones and callees only, so ESLint's sim block (eslint.config.mjs) holds the rest of
  // the row: no package and no `node:*` import (a rule pack can't glob `node:*`), and no `Date`
  // outside `new Date(value)`, `Date.UTC` and `Date.parse`, so argument-less `new Date()` too.
  // `pnpm boundaries` runs this in `check:fast` and `ci / boundaries` (#41).
  "boundaries": {
    "zones": [
      // The route files' tests (#397; ADR-0007 section 6; admin, 21 Nov 2026), before `routes` and
      // `pages`, so they take the API routes' `*.test.ts` files only, never a helper beside them:
      // they import the route files to check `runtime` and that each export hands the request to
      // `getApi()`, which they mock.
      { "name": "routeTests", "patterns": ["apps/web/src/app/api/**/tests/*.test.ts"] },
      { "name": "routes", "patterns": ["apps/web/src/app/**/route.ts"] },
      { "name": "pages", "patterns": ["apps/web/src/app/**"] },
      // The composition root's tests (#470's criteria; ADR-0007 section 6), before `api`,
      // so they take its `tests/*.test.ts` files only, never a helper beside them: they run the
      // routes on the in-memory store (store/tests/memoryStore.ts), which the store contract holds
      // to B100, instead of a fake store of their own.
      { "name": "apiTests", "patterns": ["apps/web/src/server/api/tests/*.test.ts"] },
      { "name": "api", "patterns": ["apps/web/src/server/api/**"] },
      { "name": "config", "patterns": ["apps/web/src/server/config/**"] },
      // Test-file zones (#382; ADR-0007 section 6, an allowance for test files only): the db
      // module's tests/ holds the `db` project's global setup, `readStack` and `createPlayer`,
      // which the store's and auth's stack tests use. Each sits before its module's zone, so it
      // takes the module's tests/ folder only, and the module's source keeps its own rule.
      { "name": "dbTests", "patterns": ["apps/web/src/server/db/tests/**"] },
      // The store gate (#383; ADR-0007 section 6, "The store gate"), one file, before the rest of
      // the store's tests: it plays the recorded script through B100 with the real rules, so it
      // alone runs `rules` and the sim's code. The store's other tests keep the type-only sim.
      { "name": "storeGate", "patterns": ["apps/web/src/server/store/tests/storeGate.db.test.ts"] },
      { "name": "storeTests", "patterns": ["apps/web/src/server/store/tests/**"] },
      { "name": "authTests", "patterns": ["apps/web/src/server/auth/tests/**"] },
      // game/'s tests (#383; ADR-0007 sections 2 and 6): the one test-files-only allowance,
      // `game/**/tests/**` → `store/tests/**`, so they run on the in-memory store
      // (store/tests/memoryStore.ts), a helper owned by another module's tests/ (ADR-0005 s. 4).
      { "name": "gameTests", "patterns": ["apps/web/src/server/game/**/tests/**"] },
      { "name": "db", "patterns": ["apps/web/src/server/db/**"] },
      { "name": "rules", "patterns": ["apps/web/src/server/rules/**"] },
      { "name": "store", "patterns": ["apps/web/src/server/store/**"] },
      { "name": "auth", "patterns": ["apps/web/src/server/auth/**"] },
      { "name": "timing", "patterns": ["apps/web/src/server/timing/**"] },
      { "name": "http", "patterns": ["apps/web/src/server/http/**"] },
      { "name": "game", "patterns": ["apps/web/src/server/game/**"] },
      { "name": "sim", "patterns": ["packages/sim/src/**"] },
      // The acceptance suite (#386; ADR-0007 section 6, "Acceptance tests"): black-box over HTTP,
      // so it imports no zone, and a refactor of the app or the sim can't reshape what it expects.
      { "name": "acceptance", "patterns": ["tests/acceptance/**"] }
    ],
    "rules": [
      { "from": "routes", "allow": ["api"] },
      // A test-files-only allowance: the route files, and `api`, which the tests replace with
      // `vi.mock("@/server/api")` (Fallow reads the mock as an import) and never run.
      { "from": "routeTests", "allow": ["routes", "api"] },
      { "from": "pages", "allow": ["sim"] },
      {
        "from": "api",
        "allow": ["config", "db", "rules", "store", "auth", "timing", "http", "game", "sim"]
      },
      // A test-files-only allowance: `api`'s own rule, plus `api` itself and the store's test
      // helpers. Production `api` still reaches only B100, through `store`.
      {
        "from": "apiTests",
        "allow": [
          "api",
          "config",
          "db",
          "rules",
          "store",
          "auth",
          "timing",
          "http",
          "game",
          "sim",
          "storeTests"
        ]
      },
      {
        "from": "game",
        "allow": ["rules", "timing", "sim"],
        "allowTypeOnly": ["store", "auth"]
      },
      { "from": "store", "allow": [], "allowTypeOnly": ["db", "sim"] },
      { "from": "rules", "allow": ["sim"] },
      { "from": "auth", "allow": ["config"] },
      { "from": "db", "allow": [], "allowTypeOnly": ["config"] },
      { "from": "config", "allow": [] },
      { "from": "timing", "allow": [] },
      // The HTTP contract (#395; admin, 21 Nov): the request checks, the error builder and the
      // headers. It sees the sim's types, never its code; the timing value is passed in.
      { "from": "http", "allow": [], "allowTypeOnly": ["sim"] },
      { "from": "sim", "allow": [] },
      // No allowances, type-only included: the suite's expected values are written out literally.
      { "from": "acceptance", "allow": [] },
      // Each test zone: its module's own rule, plus the module itself and the db tests' helpers.
      { "from": "dbTests", "allow": ["db"], "allowTypeOnly": ["config"] },
      { "from": "storeTests", "allow": ["store", "dbTests"], "allowTypeOnly": ["db", "sim"] },
      { "from": "authTests", "allow": ["auth", "config", "dbTests"] },
      // The store's test zone, plus the rules and the sim's code to play the script with.
      {
        "from": "storeGate",
        "allow": ["store", "dbTests", "rules", "sim"],
        "allowTypeOnly": ["db"]
      },
      // game's own rule, plus game itself and the store's test helpers; `store` stays type-only.
      {
        "from": "gameTests",
        "allow": ["game", "rules", "timing", "sim", "storeTests"],
        "allowTypeOnly": ["store", "auth"]
      }
    ],
    // A pattern matches a call and a constructor call, also through an import or a namespace.
    "calls": {
      "forbidden": [
        {
          "from": "sim",
          "callee": [
            "Date.now",
            "Math.random",
            "performance.now",
            "crypto.getRandomValues",
            "crypto.randomUUID",
            "fetch",
            "setTimeout",
            "setInterval",
            "setImmediate"
          ]
        }
      ]
    },
    // Every file in apps/web/src and packages/sim/src is in a zone. The CI scripts and the root
    // tool configs are not app code; a new folder of code needs a zone, not an entry here.
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [".github/scripts/**", "*.mjs", "*.mts", "*.d.ts"]
    }
  }
}
