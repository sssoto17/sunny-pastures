// Fallow (CONSTRAINTS.md, "Tools are dependencies"). Loosening anything here is a moved threshold
// that the floor guard reports.
{
  "$schema": "./node_modules/fallow/schema.json",
  // Duplication (CONSTRAINTS.md, duplication row; ADR-0005, section 3): exact copies of 50 tokens
  // and 5 lines or more. `mild` matches token for token, so two loops of the same shape over
  // different data aren't clones ("the same rule, not the same shape"). Fallow's built-in
  // defaults leave out *.test.ts files, and the row covers the sim's tests too, so this config
  // doesn't use them.
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "ignoreDefaults": false
  },
  // apps/web's layers (CONSTRAINTS.md, "Boundaries: server-only"; #329 decision 3, #342). Only a
  // route imports api/, only api/ wires the server modules together, and client code (pages)
  // reaches the sim's package entry and nothing in src/server/ (ADR-0006). Zones for modules that
  // don't exist yet are declared now, so each lands inside its rule. `allowTypeOnly` admits
  // `import type` only: game/ sees the store's interface, never its code, and auth's `PlayerId`,
  // never `readPlayer` (#332 decision 4); store/ sees the sim's types, never its values
  // (ADR-0001). The sim (CONSTRAINTS.md, "Boundaries: sim purity (MUST-10.1)") imports no other
  // zone, tests included, and calls nothing in `calls.forbidden`.
  // Fallow sees zones and callees only, so ESLint's sim block (eslint.config.mjs) holds the rest of
  // the row: no package and no `node:*` import (a rule pack can't glob `node:*`), and no `Date`
  // outside `new Date(value)`, `Date.UTC` and `Date.parse`, so argument-less `new Date()` too.
  // `pnpm boundaries` runs this in `check:fast` and `ci / boundaries` (#41).
  "boundaries": {
    "zones": [
      { "name": "routes", "patterns": ["apps/web/src/app/**/route.ts"] },
      { "name": "pages", "patterns": ["apps/web/src/app/**"] },
      { "name": "api", "patterns": ["apps/web/src/server/api/**"] },
      { "name": "config", "patterns": ["apps/web/src/server/config/**"] },
      { "name": "db", "patterns": ["apps/web/src/server/db/**"] },
      { "name": "rules", "patterns": ["apps/web/src/server/rules/**"] },
      { "name": "store", "patterns": ["apps/web/src/server/store/**"] },
      { "name": "auth", "patterns": ["apps/web/src/server/auth/**"] },
      { "name": "timing", "patterns": ["apps/web/src/server/timing/**"] },
      { "name": "http", "patterns": ["apps/web/src/server/http/**"] },
      { "name": "game", "patterns": ["apps/web/src/server/game/**"] },
      { "name": "sim", "patterns": ["packages/sim/src/**"] }
    ],
    "rules": [
      { "from": "routes", "allow": ["api"] },
      { "from": "pages", "allow": ["sim"] },
      {
        "from": "api",
        "allow": ["config", "db", "rules", "store", "auth", "timing", "http", "game", "sim"]
      },
      {
        "from": "game",
        "allow": ["rules", "timing", "sim"],
        "allowTypeOnly": ["store", "auth"]
      },
      { "from": "store", "allow": [], "allowTypeOnly": ["db", "sim"] },
      { "from": "rules", "allow": ["sim"] },
      { "from": "auth", "allow": ["config"] },
      { "from": "db", "allow": [], "allowTypeOnly": ["config"] },
      { "from": "config", "allow": [] },
      { "from": "timing", "allow": [] },
      // The HTTP contract (#395; admin, 21 Nov): the request checks, the error builder and the
      // headers. It sees the sim's types, never its code, and the timing header; no other module.
      { "from": "http", "allow": ["timing"], "allowTypeOnly": ["sim"] },
      { "from": "sim", "allow": [] }
    ],
    // A pattern matches a call and a constructor call, also through an import or a namespace.
    "calls": {
      "forbidden": [
        {
          "from": "sim",
          "callee": [
            "Date.now",
            "Math.random",
            "performance.now",
            "crypto.getRandomValues",
            "crypto.randomUUID",
            "fetch",
            "setTimeout",
            "setInterval",
            "setImmediate"
          ]
        }
      ]
    },
    // Every file in apps/web/src and packages/sim/src is in a zone. The CI scripts and the root
    // tool configs are not app code; a new folder of code needs a zone, not an entry here.
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [".github/scripts/**", "*.mjs", "*.mts", "*.d.ts"]
    }
  }
}
